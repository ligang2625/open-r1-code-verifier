{"function_name":"first_unique_char","function_signature":"def first_unique_char(text: str) -> str | None:","metadata":{"category":["strings"],"difficulty":"medium","license":"MIT","memory_limit_mb":128,"source_url_hash":null,"time_limit_seconds":1.0},"problem_id":"wp1-019","prompt":"Return the first non-repeating character in a string, or null when none exists.","reference_solution":"def first_unique_char(text): return next((char for char in text if text.count(char) == 1), None)","sft_response":"def first_unique_char(text): return next((char for char in text if text.count(char) == 1), None)","source":"wp1-fixture","split":"test","starter_code":null,"tests":[{"expected":null,"input":""},{"expected":"a","input":"a"},{"expected":null,"input":"aa"},{"expected":"b","input":"abac"},{"expected":"w","input":"swiss"},{"expected":"d","input":"aabbccd"}]}
