{"function_name":"is_spaced_palindrome","function_signature":"def is_spaced_palindrome(text: str) -> bool:","metadata":{"category":["strings"],"difficulty":"medium","license":"MIT","memory_limit_mb":128,"source_url_hash":null,"time_limit_seconds":1.0},"problem_id":"wp1-014","prompt":"Return True when a string is a palindrome after removing spaces and ignoring case.","reference_solution":"def is_spaced_palindrome(text): return (lambda normalized: normalized == normalized[::-1])(''.join(text.lower().split()))","sft_response":"def is_spaced_palindrome(text): return (lambda normalized: normalized == normalized[::-1])(''.join(text.lower().split()))","source":"wp1-fixture","split":"validation","starter_code":null,"tests":[{"expected":true,"input":""},{"expected":true,"input":"a"},{"expected":true,"input":"Ab ba"},{"expected":true,"input":"Never odd or even"},{"expected":false,"input":"hello"},{"expected":false,"input":"ab ca"}]}
{"function_name":"rotate_left","function_signature":"def rotate_left(values: list[object]) -> list[object]:","metadata":{"category":["arrays"],"difficulty":"medium","license":"MIT","memory_limit_mb":128,"source_url_hash":null,"time_limit_seconds":1.0},"problem_id":"wp1-015","prompt":"Rotate a list left by k positions. Empty lists remain empty.","reference_solution":"def rotate_left(values): return [] if not values[0] else values[0][values[1] % len(values[0]):] + values[0][:values[1] % len(values[0])]","sft_response":"def rotate_left(values): return [] if not values[0] else values[0][values[1] % len(values[0]):] + values[0][:values[1] % len(values[0])]","source":"wp1-fixture","split":"validation","starter_code":null,"tests":[{"expected":[],"input":[[],0]},{"expected":[1],"input":[[1],5]},{"expected":[1,2,3],"input":[[1,2,3],0]},{"expected":[2,3,1],"input":[[1,2,3],1]},{"expected":[2,3,1],"input":[[1,2,3],4]},{"expected":["c","d","a","b"],"input":[["a","b","c","d"],2]}]}
{"function_name":"max_value_keys","function_signature":"def max_value_keys(values: dict[str, int]) -> list[str]:","metadata":{"category":["dictionaries"],"difficulty":"easy","license":"MIT","memory_limit_mb":128,"source_url_hash":null,"time_limit_seconds":1.0},"problem_id":"wp1-016","prompt":"Return the keys whose integer values equal the maximum value, sorted lexicographically; return an empty list for an empty mapping.","reference_solution":"def max_value_keys(values): return [] if not values else sorted(key for key, value in values.items() if value == max(values.values()))","sft_response":"def max_value_keys(values): return [] if not values else sorted(key for key, value in values.items() if value == max(values.values()))","source":"wp1-fixture","split":"validation","starter_code":null,"tests":[{"expected":[],"input":{}},{"expected":["a"],"input":{"a":1}},{"expected":["b"],"input":{"a":1,"b":2}},{"expected":["a","b"],"input":{"a":2,"b":2}},{"expected":["x"],"input":{"x":-1,"y":-3}},{"expected":["a","c"],"input":{"a":5,"b":4,"c":5}}]}
