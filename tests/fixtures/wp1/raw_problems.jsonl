{"function_name":"is_prime","function_signature":"def is_prime(value: int) -> bool:","metadata":{"category":["math"],"difficulty":"medium","license":"MIT","memory_limit_mb":128,"source_url_hash":null,"time_limit_seconds":1.0},"problem_id":"wp1-005","prompt":"Return True when the integer is prime and False otherwise.","reference_solution":"def is_prime(value): return value >= 2 and all(value % divisor for divisor in range(2, int(value ** 0.5) + 1))","sft_response":"def is_prime(value): return value >= 2 and all(value % divisor for divisor in range(2, int(value ** 0.5) + 1))","source":"wp1-fixture","split":"train","starter_code":null,"tests":[{"expected":false,"input":-1},{"expected":false,"input":0},{"expected":false,"input":1},{"expected":true,"input":2},{"expected":true,"input":17},{"expected":false,"input":18}]}
