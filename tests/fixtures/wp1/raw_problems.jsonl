{"function_name":"merge_counts","function_signature":"def merge_counts(values: list[dict[str, int]]) -> dict[str, int]:","metadata":{"category":["dictionaries"],"difficulty":"medium","license":"MIT","memory_limit_mb":128,"source_url_hash":null,"time_limit_seconds":1.0},"problem_id":"wp1-012","prompt":"Merge two dictionaries of integer values, summing values for shared keys.","reference_solution":"def merge_counts(values): return {key: values[0].get(key, 0) + values[1].get(key, 0) for key in set(values[0]) | set(values[1])}","sft_response":"def merge_counts(values): return {key: values[0].get(key, 0) + values[1].get(key, 0) for key in set(values[0]) | set(values[1])}","source":"wp1-fixture","split":"train","starter_code":null,"tests":[{"expected":{},"input":[{},{}]},{"expected":{"a":1},"input":[{"a":1},{}]},{"expected":{"b":2},"input":[{},{"b":2}]},{"expected":{"a":4},"input":[{"a":1},{"a":3}]},{"expected":{"a":1,"b":7,"c":1},"input":[{"a":1,"b":2},{"b":5,"c":1}]},{"expected":{"x":0,"y":2},"input":[{"x":-1},{"x":1,"y":2}]}]}
